BR2_x86_64=y
BR2_x86_corei7=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=n
BR2_TOOLCHAIN_BUILDROOT_WCHAR=n
BR2_TOOLCHAIN_BUILDROOT_LOCALE=n
BR2_OPTIMIZE_S=y
BR2_STRIP_strip=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_TARGET_GENERIC_HOSTNAME="rns"
BR2_TARGET_GENERIC_ISSUE="RNS Gateway Router"
# NOTE: root has an empty password on the console. SSH is firewalled off from
# both WAN and LAN by S50gate; `rns-ctl ssh on` opens it on the LAN. Set a
# real password (or drop dropbear) before exposing 22.
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNS_ROUTER_PATH)/board/rns/x86_64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNS_ROUTER_PATH)/board/rns/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNS_ROUTER_PATH)/board/rns/x86_64/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.30"
# Name the image explicitly: post-image.sh copies bzImage by name.
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RNS_ROUTER_PATH)/board/rns/x86_64/kernel.config"
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_INSTALL_TARGET=n
BR2_LINUX_KERNEL_DTS_SUPPORT=n
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_SQUASHFS4_LARGEFILE=y
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y
BR2_TARGET_SYSLINUX_MBR=y
# syslinux 6 will not boot without ldlinux.c32 next to isolinux.bin, and
# this option defaults to empty.
BR2_TARGET_SYSLINUX_C32="ldlinux.c32"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_DNSMASQ_TFTP=n
BR2_PACKAGE_DNSMASQ_DNSSEC=n
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_NOLOGIN=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# The portal listener. socat forks a child per connection and exports the
# peer address as SOCAT_PEERADDR, which is how rns-front.sh learns which
# device is asking to redeem a voucher. Busybox's own nc cannot do this, and
# Buildroot's default busybox config does not even build nc.
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_RNS=y
# post-image.sh calls this to make the ISO; without it the script has to fall
# back to whatever mkisofs/genisoimage happens to be on the build host.
BR2_PACKAGE_HOST_XORRISO=y
