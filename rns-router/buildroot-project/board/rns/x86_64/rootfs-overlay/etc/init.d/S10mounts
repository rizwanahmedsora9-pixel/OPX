#!/bin/sh
# The ISO root is read-only squashfs. Put all writable runtime paths on tmpfs
# before rcS starts network services or daemons.
mount_tmpfs() {
  _path="$1" _size="$2"
  mkdir -p "$_path" 2>/dev/null || return 1
  mountpoint -q "$_path" && return 0
  mount -t tmpfs -o "mode=0755,size=$_size" tmpfs "$_path" 2>/dev/null || true
}

mount_tmpfs /run 16M
mount_tmpfs /var 32M
mount_tmpfs /tmp 64M
mkdir -p /run/network /run/dropbear /var/lib /var/log /var/lock \
  /var/lib/misc /var/lib/dnsmasq /var/lib/hostapd 2>/dev/null || true
# Keep the traditional path for packages that use /var/run; it resolves to
# the same volatile filesystem as /run.
rm -rf /var/run 2>/dev/null || true
ln -s /run /var/run 2>/dev/null || mkdir -p /var/run 2>/dev/null || true

mkdir -p /data 2>/dev/null

DATA_DEV=""
# The installer always labels the persistent partition RNS-DATA. Discover by
# label instead of assuming a particular controller/name (sda, vda, NVMe,
# MMC, ...), so the same image works across VirtualBox and real hardware.
for _sysdev in /sys/class/block/*; do
  [ -e "$_sysdev/partition" ] || continue
  d="/dev/${_sysdev##*/}"
  [ -b "$d" ] || continue
  if [ "$(blkid -s LABEL -o value "$d" 2>/dev/null | head -n 1)" = "RNS-DATA" ]; then
    DATA_DEV="$d"
    break
  fi
done

if [ -n "$DATA_DEV" ]; then
  mount -t ext4 -o rw,noatime "$DATA_DEV" /data || true
fi

if ! mountpoint -q /data; then
  mount -t tmpfs -o size=128M tmpfs /data
  echo "[mounts] /data on tmpfs (no persistent partition found)"
fi

mkdir -p /data/rns/database /data/rns/logs /data/rns/sessions \
         /data/rns/ratelimit /data/rns/backups /data/rns/exports 2>/dev/null

exit 0
