#!/bin/sh
# Base firewall. Fail closed.
#
# This script must never accept forwarded LAN traffic itself. It used to add
# a blanket allow for the LAN towards the WAN, which sat above the captive
# DROP that rnsd installs later: every client had free internet until the
# first housekeeping pass flushed the chain, and forever if rnsd never came
# up. Per-device allows belong to net.sh; here we only set policy, NAT and
# the management-port rules.

DATA="${RNS_DATA:-/data/rns}"
WAN_IF=$(cat "$DATA/wan.if" 2>/dev/null)
[ -n "$WAN_IF" ] || WAN_IF=eth0
ADMIN_PORT=8080

ipt() { iptables "$@"; }

ipt -N RNS_FWD 2>/dev/null || true
ipt -t nat -N RNS_PRE 2>/dev/null || true
ipt -N RNS_IN 2>/dev/null || true

ipt -C FORWARD -j RNS_FWD 2>/dev/null || ipt -I FORWARD 1 -j RNS_FWD
ipt -t nat -C PREROUTING -j RNS_PRE 2>/dev/null || ipt -t nat -I PREROUTING 1 -j RNS_PRE
ipt -C INPUT -j RNS_IN 2>/dev/null || ipt -I INPUT 1 -j RNS_IN

# Nothing is forwarded until a voucher says otherwise.
ipt -P FORWARD DROP

ipt -t nat -C POSTROUTING -o "$WAN_IF" -j MASQUERADE 2>/dev/null \
  || ipt -t nat -A POSTROUTING -o "$WAN_IF" -j MASQUERADE

# Admin panel: LAN only.
ipt -C RNS_IN -i br0 -p tcp --dport "$ADMIN_PORT" -j ACCEPT 2>/dev/null \
  || ipt -A RNS_IN -i br0 -p tcp --dport "$ADMIN_PORT" -j ACCEPT
ipt -C RNS_IN -i "$WAN_IF" -p tcp --dport "$ADMIN_PORT" -j DROP 2>/dev/null \
  || ipt -A RNS_IN -i "$WAN_IF" -p tcp --dport "$ADMIN_PORT" -j DROP

# SSH is closed from everywhere by default. dropbear ships with an empty
# root password (BR2_TARGET_GENERIC_ROOT_PASSWD=""), so exposing 22 to the
# LAN was passwordless root for any client. `rns-ctl ssh on` opens it.
for _i in "$WAN_IF" br0; do
  ipt -C RNS_IN -i "$_i" -p tcp --dport 22 -j DROP 2>/dev/null \
    || ipt -A RNS_IN -i "$_i" -p tcp --dport 22 -j DROP
done

# Captive redirect for unauthenticated clients.
ipt -t nat -C RNS_PRE -i br0 -p tcp --dport 80 -j REDIRECT --to-ports "$ADMIN_PORT" 2>/dev/null \
  || ipt -t nat -A RNS_PRE -i br0 -p tcp --dport 80 -j REDIRECT --to-ports "$ADMIN_PORT"

# Arm the captive rules now rather than waiting for rnsd's first sweep.
/usr/share/rns/bin/rns-gate-min.sh >/dev/null 2>&1

echo "[gate] FORWARD=DROP WAN=$WAN_IF LAN=br0 admin=$ADMIN_PORT (LAN only) ssh=closed"
exit 0
