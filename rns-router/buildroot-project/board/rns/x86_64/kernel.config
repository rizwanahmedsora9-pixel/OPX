CONFIG_64BIT=y
CONFIG_LOCALVERSION="-rns"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO=n
CONFIG_MODULES=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
# The ISO boots with `INITRD /rootfs.squashfs`. The kernel does recognise a
# squashfs at block 0 of an initrd (init/do_mounts_rd.c, identify_ramdisk_image)
# and loads it into /dev/ram, then makes that the root device — but only if
# initrd support and the RAM block driver are built in. Without these three
# the initrd is ignored and the kernel falls back to root=/dev/sr0, which is
# ISO9660, not squashfs, so boot panics. RAM_SIZE has to be larger than the
# rootfs image; 64 MB leaves room to grow.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=4
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_NET=y
# AF_UNIX is what netlink and therefore ip/iptables/hostapd talk over.
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
# net.sh shape_apply() needs the scheduler core, HTB for the download class,
# and the ingress qdisc + police action for the upload cap. The previous
# config had HTB and U32 but no NET_SCHED, so olddefconfig dropped them and
# shaping never applied.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_IWLWIFI=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
